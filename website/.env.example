# Absolute origin of the deployed site, no trailing slash.
# Drives canonical URLs, the sitemap, Open Graph tags and schema.org @id values.
# Set this in Vercel for Production AND Preview — a preview deployment that
# reports production canonicals will get the wrong URLs indexed.
NEXT_PUBLIC_SITE_URL=https://fivestarcaterers.net

# Resend API key - https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender on your Resend domain. Must be a domain you verified in Resend.
CONTACT_FROM_EMAIL="Five Star Caterers <enquiries@send.yourdomain.co.uk>"

# Where website enquiries are delivered.
CONTACT_TO_EMAIL=info@yourdomain.co.uk
